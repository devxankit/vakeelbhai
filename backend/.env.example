# Vakeel Bhai API. Copy to .env for local development. Never commit .env.
NODE_ENV=development
PORT=5000
LOG_LEVEL=info
# Set to 1 behind nginx so client IPs (rate limits, logs) are read from X-Forwarded-For.
TRUST_PROXY=0

# MongoDB must be a REPLICA SET (wallet/payment code uses transactions).
# Local: a single-node replica set, e.g. mongod --replSet rs0, then rs.initiate() once.
# Never point development or tests at the production database.
MONGODB_URI=mongodb://127.0.0.1:27017/vakeelbhai_dev?replicaSet=rs0

# Browser origins allowed to call the API (website / admin). The mobile app sends no Origin.
CORS_ORIGINS=http://localhost:5173

# Secrets: long random strings, different per environment.
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
OTP_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=30
ADMIN_REFRESH_TOKEN_HOURS=12
# true when the API is served over HTTPS without NODE_ENV=production (admin refresh cookie).
COOKIE_SECURE=false

# Uploads. Private files (advocate documents incl. Aadhaar, photos) are encrypted with FILES_ENC_KEY.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# BACK THIS KEY UP: without it the stored documents cannot be read. Never change it on a live server.
UPLOAD_DIR=uploads
FILES_ENC_KEY=
MAX_UPLOAD_MB=5

# Payments. disabled | razorpay | sandbox
#   sandbox: DEVELOPMENT ONLY stand-in gateway (no money moves, refused in production)
#   razorpay: needs the three keys below (test keys from the Razorpay dashboard first)
PAYMENT_PROVIDER=disabled
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook URL to register in Razorpay: https://<api-domain>/api/payments/webhook/razorpay
# Events: payment.captured, order.paid, payment.failed
RAZORPAY_WEBHOOK_SECRET=
# Unpaid checkouts close (and return any wallet amount) after this many minutes.
PAYMENT_EXPIRY_MINUTES=30

# e-Challan lookup. disabled | sandbox
#   sandbox: DEVELOPMENT ONLY sample challans for any number plate (refused in production)
#   The real provider (a BBPS biller or an aggregator API) is chosen by the client; its adapter
#   goes in src/providers/challan/.
CHALLAN_PROVIDER=disabled

# OTP login
OTP_TTL_SECONDS=300
OTP_RESEND_SECONDS=30
OTP_MAX_SENDS_PER_HOUR=5
OTP_MAX_ATTEMPTS=5
# Fixed codes for app-store review accounts only: phone:code,phone:code. Leave empty otherwise.
OTP_TEST_NUMBERS=
# console (dev only: prints codes to the log) | smsindiahub (not integrated yet) | disabled
SMS_PROVIDER=console

# Requests per IP: auth endpoints per 15 min, all API endpoints per minute.
RATE_LIMIT_AUTH=30
RATE_LIMIT_API=300

# Admin panel login protection
ADMIN_MAX_FAILED_LOGINS=5
ADMIN_LOCK_MINUTES=15
